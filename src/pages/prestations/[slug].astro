---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import Coupe from '../../components/Coupe.astro';
import Txt from '../../components/Txt.astro';
import { services, commitments, company, type Service } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props { service: Service }
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const bySlug = Object.fromEntries(services.map((s) => [s.slug, s]));
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Prestations', path: '/prestations/' },
  { name: service.title, path: `/prestations/${service.slug}/` },
];
---
<Base title={service.seoTitle} description={service.seoDescription} breadcrumb={crumbs}>
  <PageHead title={service.title} crumbs={crumbs}>
    <p class="lead">{service.summary}</p>
    <div slot="aside" class="svc-coupe">
      <Coupe variant="scene" scene={service.slug} />
    </div>
  </PageHead>

  <section class="section" aria-labelledby="presentation-titre">
    <div class="container svc-grid">
      <div class="svc-story">
        <h2 id="presentation-titre" class="svc-headline">{service.headline}</h2>
        <p class="svc-lead">{service.lead}</p>
        {service.intro.map((p) => <p>{p}</p>)}

        <div class="svc-links">
          <h3 class="svc-links-title">Sur la coupe</h3>
          <ul>
            {service.links.map((l) => {
              const o = bySlug[l.slug];
              return (
                <li>
                  <a href={`/prestations/${o.slug}/`}>
                    <span class="mark" aria-hidden="true">{o.mark}</span>
                    <span><strong>{o.title}</strong><span class="svc-link-text">{l.text}</span></span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
      <div class="card included">
        <h2 class="svc-h2">Ce qui est inclus</h2>
        <ul class="check-list">
          {service.included.map((item) => <li><Icon name="check" class="check-icon" />{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="commitments on-dark" aria-labelledby="engagements-titre">
    <div class="container">
      <h2 id="engagements-titre" class="svc-h2">{commitments.title}</h2>
      <ul class="commit-list">
        {commitments.items.map((c) => (
          <li>
            <Icon name={c.icon} class="commit-icon" />
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            {c.detail === 'insurance' && (
              <p class="commit-detail">
                <Txt value={company.insurance.insurer} />, contrat n° <Txt value={company.insurance.policyNumber} />
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section svc-photos" aria-labelledby="photos-titre">
    <div class="container">
      <h2 id="photos-titre" class="svc-h2">En images</h2>
      <div class="photo-grid">
        {service.photos.map((ph) => (
          <Photo file={ph.file} alt={ph.alt} sizes="(min-width: 48rem) 50vw, 100vw" />
        ))}
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="section" aria-labelledby="autres-titre">
    <div class="container">
      <h2 id="autres-titre" class="svc-h2">Les autres prestations</h2>
      <ul class="others">
        {others.map((s) => (
          <li><a href={`/prestations/${s.slug}/`}><Icon name={s.icon} />{s.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .svc-h2 { font-size: var(--fs-h3); }
  /* Présentation : titre de parti pris, accroche, récit */
  .svc-headline { font-size: var(--fs-h2); max-width: 18ch; margin-bottom: var(--sp-5); }
  .svc-lead { font-size: var(--fs-lg); font-weight: 500; line-height: 1.5; color: var(--c-text); }
  .svc-story > p { color: var(--c-text-2); }
  .svc-story > p.svc-lead { color: var(--c-text); }
  /* Sur la coupe : liens avec les métiers voisins */
  .svc-links { margin-top: var(--sp-7); border-top: 2px solid var(--c-text); }
  .svc-links-title { font-size: var(--fs-h4); margin: var(--sp-4) 0 var(--sp-2); }
  .svc-links ul { list-style: none; margin: 0; padding: 0; }
  .svc-links li { margin: 0; border-bottom: 1px solid var(--c-field-border); }
  .svc-links a {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
    padding-block: var(--sp-4);
    text-decoration: none;
    min-height: var(--tap);
  }
  .svc-links a:hover strong { color: var(--c-accent-dark); text-decoration: underline; }
  .svc-links strong { display: block; font-weight: 600; }
  .svc-link-text { display: block; color: var(--c-text-2); }
  .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1.5px solid var(--c-text);
    border-radius: 50%;
    font-family: var(--f-display);
    font-weight: 700;
  }
  .svc-links a:hover .mark { background: var(--c-accent); border-color: var(--c-accent); }
  /* Mes engagements : trois cellules à filets, comme le cartouche */
  .commitments { padding-block: var(--section-y); }
  .commit-list { list-style: none; margin: var(--sp-5) 0 0; padding: 0; display: grid; border: 1px solid var(--c-line-dark); }
  @media (min-width: 48rem) { .commit-list { grid-template-columns: repeat(3, 1fr); } }
  .commit-list li { margin: 0; padding: var(--sp-6) var(--sp-5); border-bottom: 1px solid var(--c-line-dark); }
  @media (min-width: 48rem) {
    .commit-list li { border-bottom: 0; border-right: 1px solid var(--c-line-dark); }
    .commit-list li:last-child { border-right: 0; }
  }
  .commit-list li:last-child { border-bottom: 0; }
  .commit-list :global(.commit-icon) { width: 2rem; height: 2rem; color: var(--c-accent); margin-bottom: var(--sp-3); }
  .commit-list h3 { font-size: var(--fs-h4); margin-bottom: var(--sp-2); }
  .commit-list p { color: var(--c-on-dark-2); margin: 0; }
  .commit-list .commit-detail { margin-top: var(--sp-3); font-size: var(--fs-sm); }
  .svc-grid { display: grid; gap: var(--sp-7); align-items: start; }
  @media (min-width: 64rem) { .svc-grid { grid-template-columns: 3fr 2fr; gap: var(--sp-9); } }
  .included { padding: var(--sp-6); }
  .check-list { list-style: none; padding: 0; margin: 0; }
  .check-list li {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    padding-block: var(--sp-3);
    margin: 0;
    border-bottom: 1px solid var(--c-border);
  }
  .check-list li:last-child { border-bottom: 0; }
  .check-list :global(.check-icon) { width: 1.25rem; height: 1.25rem; margin-top: 0.2rem; color: var(--c-accent-dark); flex: none; }
  .svc-photos { padding-top: 0; }
  .photo-grid { display: grid; gap: var(--sp-4); }
  @media (min-width: 48rem) { .photo-grid { grid-template-columns: 1fr 1fr; } }
  .photo-grid :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-md); }
  .others {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .others li { margin: 0; }
  .others a {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 3.5rem;
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    font-weight: 600;
    text-decoration: none;
  }
  .others a:hover { border-color: var(--c-accent-dark); }
  .others :global(svg) { width: 1.75rem; height: 1.75rem; flex: none; }
</style>
