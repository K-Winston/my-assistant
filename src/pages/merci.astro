---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { thanks } from '../data/site';
---
<Base title={thanks.title} description={thanks.text} noindex>
  <PageHead title={thanks.title}>
    <p class="lead">{thanks.text}</p>
  </PageHead>
  <section class="section container">
    <a class="btn btn-primary" href="/">{thanks.back}</a>
  </section>
</Base>
