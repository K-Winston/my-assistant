---
// Icônes en trait fin (SVG inline, sans dépendance). Décoratives par défaut (aria-hidden).
interface Props { name: string; class?: string; label?: string }
const { name, class: className = 'icon-line', label } = Astro.props;

const paths: Record<string, string> = {
  // Prestations
  foundation:
    '<path d="M3 20h18"/><path d="M5 20v-4h14v4"/><path d="M7 16v-3h10v3"/><path d="M9 13V9h6v4"/><path d="M12 9V4"/><path d="M10 4h4"/>',
  wall:
    '<rect x="3" y="5" width="18" height="14" rx="0.5"/><path d="M3 9.7h18M3 14.3h18"/><path d="M9 5v4.7M15 5v4.7M6 9.7v4.6M12 9.7v4.6M18 9.7v4.6M9 14.3V19M15 14.3V19"/>',
  roof:
    '<path d="M2.5 11.5 12 4l9.5 7.5"/><path d="M5 9.6V20h14V9.6"/><path d="M5 13.5h14"/><path d="M8 4.5h2v2.3"/><path d="M10 20v-4h4v4"/>',
  electric:
    '<path d="M13 3 6 13.5h5.5L10.5 21 18 10.5h-5.5L13 3Z"/>',
  plumbing:
    '<path d="M4 8h7a3 3 0 0 1 3 3v2"/><path d="M4 5v6"/><path d="M14 13h6v3h-6z"/><path d="M17 16v2.5"/><path d="M15.5 21a1.5 1.5 0 0 0 3 0c0-1-1.5-2.5-1.5-2.5S15.5 20 15.5 21Z"/>',
  drywall:
    '<rect x="3" y="3" width="18" height="18" rx="0.5"/><path d="M9 3v18M15 3v18"/><path d="M5.5 6.5v.01M5.5 12v.01M5.5 17.5v.01M18.5 6.5v.01M18.5 12v.01M18.5 17.5v.01"/>',
  // Interface
  phone:
    '<path d="M5 4h3.5l1.5 4-2 1.3a10.5 10.5 0 0 0 6.7 6.7L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  pin: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  shield: '<path d="M12 3 5 6v5.5c0 4.2 3 7.6 7 9.5 4-1.9 7-5.3 7-9.5V6l-7-3Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.7 3.6-6 7-6s6.2 2.3 7 6"/>',
  compass: '<path d="M12 3v3"/><path d="m8 21 4-15 4 15"/><path d="M6.5 15.5h11"/><circle cx="12" cy="6" r="1.4"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  back: '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
};
const body = paths[name] ?? '';
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
