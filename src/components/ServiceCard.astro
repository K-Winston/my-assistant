---
import type { Service } from '../data/site';
import Icon from './Icon.astro';
interface Props { service: Service; headingLevel?: 'h2' | 'h3' }
const { service, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="card service-card">
  <Icon name={service.icon} />
  <H class="service-title">
    <a class="stretched-link" href={`/prestations/${service.slug}/`}>{service.title}</a>
  </H>
  <p>{service.summary}</p>
  <span class="service-more" aria-hidden="true">Voir le détail <Icon name="arrow" class="more-icon" /></span>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    transition: border-color 0.15s;
  }
  .service-card:hover { border-color: var(--c-accent-dark); }
  .service-card:focus-within { outline: 3px solid var(--c-accent-dark); outline-offset: 2px; }
  .service-title { font-size: var(--fs-h3); margin: var(--sp-2) 0 0; }
  .service-title a { text-decoration: none; }
  /* Toute la carte est cliquable via le lien du titre */
  .service-title a::after { content: ''; position: absolute; inset: 0; }
  .service-title a:focus-visible { outline: none; }
  .service-card p { color: var(--c-text-2); margin: 0; flex: 1; }
  .service-more {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--tap);
    font-weight: 600;
    color: var(--c-accent-dark);
  }
  .service-more :global(.more-icon) { width: 1.1rem; height: 1.1rem; }
</style>
