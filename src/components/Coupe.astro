---
// Coupe de principe de la maison, des fondations (repère A) à la toiture (repère F).
// - variant "hero" : grande coupe animée avec étiquettes cliquables (page d'accueil).
// - variant "compact" : petite coupe décorative, un niveau mis en évidence.
// - variant "scene" : coupe d'en-tête de page avec un ouvrier qui travaille à l'endroit du métier
//   (scene = slug de prestation, ou 'histoire' / 'contact'). L'animation joue une fois puis
//   s'arrête sur le travail terminé ; avec « réduire les animations », la scène finie est affichée.
// Les étiquettes sont de vrais liens HTML posés sur le dessin ; le dessin lui-même est décoratif.
import { services } from '../data/site';

interface Props {
  variant?: 'hero' | 'compact' | 'scene';
  /** scène de l'ouvrier (variant scene) : slug de prestation, 'histoire' ou 'contact' */
  scene?: string;
  /** slug de la prestation à mettre en évidence (variant compact) */
  focus?: string;
  caption?: string;
}
const { variant = 'hero', focus, caption, scene } = Astro.props;

// Niveau du dessin correspondant à chaque prestation
const layerOf: Record<string, string> = {
  'fondations-gros-oeuvre': 'fondations',
  'maconnerie-extensions': 'maconnerie',
  plomberie: 'plomberie',
  electricite: 'electricite',
  'placo-amenagement': 'placo',
  toiture: 'toiture',
};
const labels = [...services].sort((a, b) => b.mark.localeCompare(a.mark)); // F (haut) → A (bas)
const focusLayer = focus ? layerOf[focus] : scene ? layerOf[scene] : undefined;
const sc = scene ? (layerOf[scene] ?? scene) : undefined; // nom court de la scène
const viewBox = variant === 'scene' ? '0 0 560 540' : '0 0 760 540';
// Tuiles posées une à une sur le versant droit (scène toiture), de l'égout vers le faîtage
const tiles = Array.from({ length: 8 }, (_, k) => ({
  x1: 534 - 29.25 * k, y1: 234 - 21 * k, x2: 534 - 29.25 * (k + 1) + 2, y2: 234 - 21 * (k + 1) + 1.5,
}));
// Rangs de briques montés un à un (scène maçonnerie), du bas vers le haut
const courses = [...Array.from({ length: 11 }, (_, i) => ({ y: 390 - 16 * i, h: 16 })), { y: 222, h: 8 }];
const screws = [256, 286, 316, 346, 376];
---
<figure class:list={['coupe', `coupe--${variant}`, sc && `scene-${sc}`]} data-focus={focusLayer}>
  <div class="coupe-sheet">
    <svg class="coupe-svg" viewBox={viewBox} fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="h-sol" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="14" class="hatch" />
        </pattern>
        <pattern id="h-beton" width="16" height="16" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="5" r="1.1" class="dot" /><circle cx="12" cy="11" r="1.4" class="dot" /><path d="M9 3l2 2-2 1z" class="dot" />
        </pattern>
        <pattern id="h-maconnerie" width="24" height="16" patternUnits="userSpaceOnUse">
          <path d="M0 0.5H24M0 8.5H24M6 0.5V8.5M18 8.5V16" class="hatch" />
        </pattern>
        <pattern id="h-isolant" width="12" height="20" patternUnits="userSpaceOnUse">
          <path d="M0 0 C6 5 6 5 12 10 C6 15 6 15 0 20" class="hatch" />
        </pattern>
      </defs>

      <!-- Repères fixes : cotes verticales et niveau ±0,00 -->
      <g class="static">
        <path d="M26 66V482M20 72l12-12M20 228l12-12M20 412l12-12M20 426l12-12M20 488l12-12" />
        <path d="M84 404l8 10 8-10z" />
      </g>

      <!-- A. Fondations : terre, semelles, dallage -->
      <g class="layer layer-fondations">
        <rect x="0" y="420" width="540" height="120" fill="url(#h-sol)" class="soil" />
        <path d="M0 420H540" class="ground" />
        <rect x="100" y="420" width="52" height="62" fill="url(#h-beton)" />
        <rect x="448" y="420" width="52" height="62" fill="url(#h-beton)" />
        <rect x="116" y="406" width="368" height="14" fill="url(#h-beton)" />
        <path d="M500 470H556" class="leader" /><circle cx="500" cy="470" r="3" class="pin" />
      </g>

      <!-- B. Maçonnerie : murs porteurs -->
      <g class="layer layer-maconnerie">
        <rect x="116" y="222" width="24" height="184" fill="url(#h-maconnerie)" />
        <rect x="460" y="222" width="24" height="184" fill="url(#h-maconnerie)" class="wall-right" />
        <path d="M484 395H556" class="leader" /><circle cx="484" cy="395" r="3" class="pin" />
      </g>

      <!-- C. Plomberie : arrivée d'eau, lavabo, évacuation -->
      <g class="layer layer-plomberie">
        <path d="M392 330h56q0 20-28 20t-28-20z" />
        <path d="M440 500V330M440 330v-14h-12" class="pipe" />
        <path d="M414 350V432H360V500" class="drain" />
        <path d="M448 335H556" class="leader" /><circle cx="448" cy="335" r="3" class="pin" />
      </g>

      <!-- D. Électricité : tableau, câble, luminaire, prise -->
      <g class="layer layer-electricite">
        <rect x="154" y="292" width="20" height="30" />
        <path d="M164 292V248H286V360" class="cable" />
        <path d="M226 248v10" /><circle cx="226" cy="264" r="6" />
        <rect x="282" y="360" width="10" height="14" />
        <path d="M232 264H556" class="leader" /><circle cx="232" cy="264" r="3" class="pin" />
      </g>

      <!-- E. Placo : doublages, faux plafond, cloison isolée -->
      <g class="layer layer-placo">
        <path d="M146 236V406M454 236V406M146 236H454" />
        <rect x="296" y="236" width="12" height="170" fill="url(#h-isolant)" />
        <path d="M454 262L496 210H556" class="leader" /><circle cx="454" cy="262" r="3" class="pin" />
      </g>

      <!-- F. Toiture : charpente et couverture en tuiles -->
      <g class="layer layer-toiture">
        <path d="M110 222H490M86 226L300 82L514 226M300 82V222M300 196L214 140M300 196L386 140" class="frame" pathLength="1" />
        <path d="M66 234L300 66" class="tiles" />
        <path d="M300 66L534 234" class="tiles tiles-right" />
        <path d="M410 145L470 100H556" class="leader" /><circle cx="410" cy="145" r="3" class="pin" />
      </g>


      {variant === 'scene' && (
        <g class="scene">
          {sc === 'fondations' && (
            <g>
              <g class="dirt"><circle cx="492" cy="424" r="2.2" /><circle cx="497" cy="421" r="1.6" /><circle cx="488" cy="420" r="1.4" /></g>
              <g transform="translate(526 420)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L8 0" />
                <g transform="translate(0 -44)">
                  <g class="anim dig">
                    <path d="M0 0L-12 8L-16 12M0 0L-6 14L-14 22" />
                    <path d="M-10 4L-34 58" class="tool" /><path d="M-40 54L-28 60L-32 72L-42 68Z" class="tool tool-fill" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'maconnerie' && (
            <g>
              {courses.map((c, i) => (
                <rect x="460" y={c.y} width="24" height={c.h} fill="url(#h-maconnerie)" class="brick" data-i={i} />
              ))}
              <g transform="translate(522 420)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L8 0M0 -44L-6 -30" />
                <g transform="translate(0 -44)">
                  <g class="anim trowel">
                    <path d="M0 0L-12 2L-22 2" /><path d="M-22 2L-26 -2M-24 -4L-36 0L-26 5Z" class="tool" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'plomberie' && (
            <g>
              <circle cx="428" cy="322" r="2.6" class="drop tool-fill" />
              <g transform="translate(404 406)" class="man">
                <circle cx="0" cy="-41" r="7" /><path d="M0 -34V-16M0 -16L10 -8L6 0M0 -16L-6 -6L-12 0" />
                <g transform="translate(0 -28)">
                  <g class="anim wrench">
                    <path d="M0 0L16 4L30 -4" /><path d="M30 -4L37 -8M37 -8l2 -5M37 -8l5 2" class="tool" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'electricite' && (
            <g>
              <path d="M194 406L204 318M214 406L224 318M196 384H216M198.5 362H218.5M201 340H221" class="ladder" />
              <g class="glow"><circle cx="226" cy="264" r="10" class="tool-fill" /><path d="M226 280v8M212 276l-6 6M240 276l6 6M206 264h-8M246 264h8" class="tool" /></g>
              <g transform="translate(211 340)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-6 0M0 -24L6 0M0 -44L-10 -32" />
                <g transform="translate(0 -44)">
                  <g class="anim screw">
                    <path d="M0 0L8 -14L12 -24" /><path d="M12 -24L15 -31" class="tool" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'placo' && (
            <g>
              <g class="panel"><rect x="308" y="238" width="8" height="166" class="tool" /></g>
              {screws.map((y, i) => <circle cx="312" cy={y} r="2.2" class="screw-dot tool-fill" data-i={i} />)}
              <g transform="translate(352 406)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L8 0M0 -44L-8 -30" />
                <g transform="translate(0 -44)">
                  <g class="anim drill">
                    <path d="M0 0L-12 6L-22 4" /><path d="M-22 1h-9v7h9zM-31 4.5h-7M-26 8v6" class="tool" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'toiture' && (
            <g>
              {tiles.map((t, k) => (
                <path d={`M${t.x1} ${t.y1}L${t.x2} ${t.y2}`} class="tile" data-i={k} />
              ))}
              <g transform="translate(340 92)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L6 -4L10 2M0 -44L-8 -30" />
                <g transform="translate(0 -44)">
                  <g class="anim hammer">
                    <path d="M0 0L14 10" /><path d="M14 10L22 4M19 0L25 8" class="tool" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'histoire' && (
            <g>
              <g transform="translate(528 420)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L8 0M0 -44L-22 -36" />
                <g transform="translate(0 -44)">
                  <g class="anim point"><path d="M0 0L-12 -6L-24 -14" /></g>
                </g>
              </g>
              <g transform="translate(503 420) scale(0.72)" class="man man-small">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L8 0M0 -44L6 -32" />
                <g transform="translate(0 -44)">
                  <g class="anim trowel">
                    <path d="M0 0L-10 2L-16 2" /><path d="M-16 2L-20 -2M-18 -4L-30 0L-20 5Z" class="tool" />
                  </g>
                </g>
              </g>
            </g>
          )}
          {sc === 'contact' && (
            <g>
              <g transform="translate(524 420)" class="man">
                <circle cx="0" cy="-57" r="7" /><path d="M0 -50V-24M0 -24L-8 0M0 -24L8 0M0 -44L-12 -32" />
                <rect x="-26" y="-40" width="15" height="20" class="tool" />
                <path d="M-23 -31l3 3l6 -7" class="tool check" />
                <g transform="translate(0 -44)">
                  <g class="anim write"><path d="M0 0L-8 14L-14 12" /><path d="M-14 12L-20 8" class="tool" /></g>
                </g>
              </g>
            </g>
          )}
        </g>
      )}

      <!-- Repères posés sur le dessin (petit écran, quand les étiquettes passent sous le dessin) -->
      <g class="marks">
        <circle cx="500" cy="470" r="13" /><text x="500" y="475">A</text>
        <circle cx="484" cy="378" r="13" /><text x="484" y="383">B</text>
        <circle cx="448" cy="312" r="13" /><text x="448" y="317">C</text>
        <circle cx="232" cy="286" r="13" /><text x="232" y="291">D</text>
        <circle cx="454" cy="262" r="13" /><text x="454" y="267">E</text>
        <circle cx="410" cy="122" r="13" /><text x="410" y="127">F</text>
      </g>

      <!-- Fil à plomb -->
      <g class="plumb">
        <path d="M60 240V384" class="plumb-line" />
        <path d="M54 384h12l-6 16z" class="plumb-bob" />
      </g>
    </svg>

    {variant === 'hero' && (
      <ul class="coupe-labels">
        {labels.map((s) => (
          <li class={`lbl lbl-${s.mark}`}>
            <a href={`/prestations/${s.slug}/`} data-layer={layerOf[s.slug]}>
              <span class="lbl-mark" aria-hidden="true">{s.mark}</span>
              <span class="lbl-name">{s.short}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .coupe { margin: 0; color: var(--c-coupe-line); }
  .coupe-sheet { position: relative; }
  .coupe-svg { width: 100%; height: auto; overflow: visible; }
  .coupe-svg :global(*) { vector-effect: non-scaling-stroke; }
  .coupe-svg { stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .coupe-svg .hatch { stroke: var(--c-coupe-hatch); stroke-width: 1; }
  .coupe-svg .dot { fill: var(--c-coupe-hatch); stroke: none; }
  .coupe-svg .soil { stroke: none; }
  .coupe-svg .ground { stroke-width: 2.5; }
  .coupe-svg .tiles { stroke-width: 7; stroke-dasharray: 11 3; stroke-linecap: butt; }
  .coupe-svg .frame { stroke-width: 2; }
  .coupe-svg .pipe { stroke-width: 3; }
  .coupe-svg .drain { stroke-dasharray: 6 4; }
  .coupe-svg .cable { stroke-dasharray: 2 4; stroke-width: 2; }
  .coupe-svg .leader { stroke-width: 1; stroke: var(--c-coupe-leader); }
  .coupe-svg .pin { fill: currentColor; stroke: none; }
  .coupe-svg .static { color: var(--c-coupe-hatch); }
  .coupe-svg .static path { stroke-width: 1; }
  .coupe-svg .plumb { color: var(--c-accent); }
  .coupe-svg .plumb-line { stroke-dasharray: 3 4; stroke-width: 1.25; }
  .coupe-svg .plumb-bob { fill: currentColor; stroke: none; }
  .layer { transition: opacity var(--dur-ui) ease, color var(--dur-ui) ease; }

  /* Étiquettes (liens) posées à droite du dessin, à la hauteur de leur repère */
  .coupe-labels { list-style: none; margin: 0; padding: 0; }
  .lbl { position: absolute; left: 73.5%; margin: 0; transform: translateY(-50%); }
  .lbl-F { top: 18.5%; }
  .lbl-E { top: 38.9%; }
  .lbl-D { top: 48.9%; }
  .lbl-C { top: 62%; }
  .lbl-B { top: 73.1%; }
  .lbl-A { top: 87%; }
  .lbl a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: var(--tap);
    padding-right: 0.25rem;
    color: var(--c-on-dark);
    text-decoration: none;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(0.8rem, 0.55rem + 1.1vw, 1.2rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .lbl-mark {
    display: inline-grid;
    place-items: center;
    width: 1.55em;
    height: 1.55em;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 0.8em;
    line-height: 1;
    transition: background-color var(--dur-ui) ease, color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }
  .lbl a:hover, .lbl a:focus-visible { color: var(--c-accent); }
  .lbl a:hover .lbl-mark, .lbl a:focus-visible .lbl-mark {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-on-accent);
  }

  /* Petit écran : les étiquettes passent en liste sous le dessin (zones de toucher ≥ 44 px) */
  @media (max-width: 39.99rem) {
    .coupe-labels { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--sp-3); margin-top: var(--sp-2); }
    .lbl { position: static; transform: none; }
    .lbl a { font-size: 1rem; }
    .coupe--hero .coupe-sheet { overflow: hidden; }
    .coupe--hero .leader, .coupe--hero .pin { display: none; }
    .coupe--hero .marks { display: inline; }
    .coupe--hero .coupe-svg { width: 136%; max-width: none; } /* recadre sur le dessin (0 → 558) */
  }

  figcaption { margin-top: var(--sp-3); font-size: var(--fs-xs); color: var(--c-on-dark-2); }

  /* Mise en évidence d'un niveau : au survol d'une étiquette (accueil) ou fixée (pages prestations) */
  .coupe:has([data-layer='fondations']:is(:hover, :focus-visible)) .layer:not(.layer-fondations),
  .coupe:has([data-layer='maconnerie']:is(:hover, :focus-visible)) .layer:not(.layer-maconnerie),
  .coupe:has([data-layer='plomberie']:is(:hover, :focus-visible)) .layer:not(.layer-plomberie),
  .coupe:has([data-layer='electricite']:is(:hover, :focus-visible)) .layer:not(.layer-electricite),
  .coupe:has([data-layer='placo']:is(:hover, :focus-visible)) .layer:not(.layer-placo),
  .coupe:has([data-layer='toiture']:is(:hover, :focus-visible)) .layer:not(.layer-toiture),
  .coupe[data-focus='fondations'] .layer:not(.layer-fondations),
  .coupe[data-focus='maconnerie'] .layer:not(.layer-maconnerie),
  .coupe[data-focus='plomberie'] .layer:not(.layer-plomberie),
  .coupe[data-focus='electricite'] .layer:not(.layer-electricite),
  .coupe[data-focus='placo'] .layer:not(.layer-placo),
  .coupe[data-focus='toiture'] .layer:not(.layer-toiture) { opacity: 0.25; }

  .coupe:has([data-layer='fondations']:is(:hover, :focus-visible)) .layer-fondations,
  .coupe:has([data-layer='maconnerie']:is(:hover, :focus-visible)) .layer-maconnerie,
  .coupe:has([data-layer='plomberie']:is(:hover, :focus-visible)) .layer-plomberie,
  .coupe:has([data-layer='electricite']:is(:hover, :focus-visible)) .layer-electricite,
  .coupe:has([data-layer='placo']:is(:hover, :focus-visible)) .layer-placo,
  .coupe:has([data-layer='toiture']:is(:hover, :focus-visible)) .layer-toiture,
  .coupe[data-focus='fondations'] .layer-fondations,
  .coupe[data-focus='maconnerie'] .layer-maconnerie,
  .coupe[data-focus='plomberie'] .layer-plomberie,
  .coupe[data-focus='electricite'] .layer-electricite,
  .coupe[data-focus='placo'] .layer-placo,
  .coupe[data-focus='toiture'] .layer-toiture { color: var(--c-accent); }

  .coupe--compact .leader, .coupe--compact .pin { display: none; }
  .marks { display: none; }
  .marks circle { fill: var(--c-dark); stroke: var(--c-on-dark); stroke-width: 1.5; }
  .marks text { fill: var(--c-on-dark); stroke: none; font: 700 15px var(--f-display); text-anchor: middle; }

  /* ---------- Le moment animé : la maison se construit de bas en haut ----------
     fondations 0 ms → murs 160 → plomberie 300 → électricité 400 → placo 500
     → charpente tracée 600–1300 → couverture 1100 → fil à plomb 1300 → étiquettes 1350+ */
  @keyframes build-in { from { opacity: 0; transform: translateY(10px); } }
  @keyframes draw { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes drop { from { transform: scaleY(0); } }
  @keyframes bob { from { opacity: 0; transform: translateY(-140px); } }

  .coupe--hero .layer { animation: build-in 650ms var(--ease-out) both; }
  .coupe--hero .layer-maconnerie { animation-delay: 160ms; }
  .coupe--hero .layer-plomberie { animation-delay: 300ms; }
  .coupe--hero .layer-electricite { animation-delay: 400ms; }
  .coupe--hero .layer-placo { animation-delay: 500ms; }
  .coupe--hero .layer-toiture { animation: fade 200ms ease 600ms both; }
  .coupe--hero .layer-toiture .frame { animation: draw 700ms var(--ease-in-out) 600ms both; }
  .coupe--hero .layer-toiture .tiles { animation: fade 400ms var(--ease-out) 1100ms both; }
  .coupe--hero .plumb-line { transform-box: fill-box; transform-origin: top; animation: drop 500ms var(--ease-out) 1300ms both; }
  .coupe--hero .plumb-bob { animation: bob 500ms var(--ease-out) 1300ms both; }
  .coupe--hero .lbl { animation: fade 400ms var(--ease-out) both; }
  .coupe--hero .lbl-A { animation-delay: 1350ms; }
  .coupe--hero .lbl-B { animation-delay: 1400ms; }
  .coupe--hero .lbl-C { animation-delay: 1440ms; }
  .coupe--hero .lbl-D { animation-delay: 1470ms; }
  .coupe--hero .lbl-E { animation-delay: 1500ms; }
  .coupe--hero .lbl-F { animation-delay: 1520ms; }


  /* ---------- Scènes : un ouvrier au travail (pages intérieures) ---------- */
  .coupe--scene .leader, .coupe--scene .pin, .coupe--scene .marks { display: none; }
  .coupe--scene[data-focus] .layer { opacity: 0.45; }
  .coupe--scene .layer-fondations, .coupe--scene[data-focus] .layer-fondations { opacity: 1; } /* le sol reste lisible */
  .coupe--scene[data-focus='fondations'] .layer-fondations { color: var(--c-accent); }
  .scene-maconnerie .wall-right, .scene-toiture .tiles-right { display: none; }
  .scene .man { color: var(--c-on-dark); stroke-width: 2.2; }
  .scene .man circle { fill: var(--c-dark); }
  .scene .tool { color: var(--c-accent); stroke: var(--c-accent); stroke-width: 2; }
  .scene .tool-fill { fill: var(--c-accent); stroke: none; }
  .scene rect.tool { fill: var(--c-dark); }
  .scene .ladder { color: var(--c-coupe-leader); stroke-width: 1.5; }
  .scene .brick { stroke: var(--c-accent); stroke-width: 1.5; }
  .scene .tile { stroke: var(--c-accent); stroke-width: 7; stroke-dasharray: 11 3; stroke-linecap: butt; }
  .scene .dirt circle { fill: var(--c-coupe-line); stroke: none; }
  .scene .man-small { stroke-width: 3; } /* compense l'échelle 0,72 */

  /* Rotation autour de l'épaule : chaque bras est dessiné depuis l'origine de son groupe */
  .scene .anim { transform-box: view-box; transform-origin: 0 0; }
  .scene .brick, .scene .tile, .scene .screw-dot, .scene .glow, .scene .drop, .scene .check { transform-box: fill-box; transform-origin: center; }

  @keyframes dig { 0%, 100% { transform: rotate(0); } 40% { transform: rotate(16deg); } 65% { transform: rotate(-5deg); } }
  @keyframes dirt { 0%, 40% { opacity: 0; transform: translate(0, 0); } 55% { opacity: 1; } 90%, 100% { opacity: 0; transform: translate(-16px, -26px); } }
  @keyframes swing { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-22deg); } }
  @keyframes wrist-turn { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(8deg); } }
  @keyframes buzz { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(1.5px, -0.5px); } }
  @keyframes appear { from { opacity: 0; transform: scale(0.4); } }
  @keyframes lay { from { opacity: 0; transform: translateY(-10px); } }
  @keyframes slide-in { from { opacity: 0; transform: translateX(40px); } }
  @keyframes glow-on { 0% { opacity: 0; } 30% { opacity: 1; } 40% { opacity: 0.2; } 55%, 100% { opacity: 1; } }
  @keyframes drop { 0% { opacity: 0; transform: translateY(0); } 15% { opacity: 1; } 85% { opacity: 1; transform: translateY(16px); } 100% { opacity: 0; transform: translateY(18px); } }
  @keyframes fade-in { from { opacity: 0; } }

  /* En attente tant que la scène n'est pas à l'écran (script ci-dessous) */
  .coupe[data-wait] .scene, .coupe[data-wait] .scene * { animation-play-state: paused !important; }

  /* Fondations : 4 coups de pelle */
  .scene .dig { animation: dig 1s var(--ease-in-out) 0.4s 4; }
  .scene .dirt { animation: dirt 1s ease-out 0.4s 4 both; }
  .scene-fondations .dirt { opacity: 0; }
  /* Maçonnerie : le mur monte rang par rang, la truelle suit */
  .scene .trowel { animation: swing 0.55s var(--ease-in-out) 0.3s 8; }
  .scene .brick { animation: lay 350ms var(--ease-out) both; }
  .scene .brick:nth-of-type(1) { animation-delay: 0.3s; }  .scene .brick:nth-of-type(2) { animation-delay: 0.65s; }
  .scene .brick:nth-of-type(3) { animation-delay: 1s; }    .scene .brick:nth-of-type(4) { animation-delay: 1.35s; }
  .scene .brick:nth-of-type(5) { animation-delay: 1.7s; }  .scene .brick:nth-of-type(6) { animation-delay: 2.05s; }
  .scene .brick:nth-of-type(7) { animation-delay: 2.4s; }  .scene .brick:nth-of-type(8) { animation-delay: 2.75s; }
  .scene .brick:nth-of-type(9) { animation-delay: 3.1s; }  .scene .brick:nth-of-type(10) { animation-delay: 3.45s; }
  .scene .brick:nth-of-type(11) { animation-delay: 3.8s; } .scene .brick:nth-of-type(12) { animation-delay: 4.15s; }
  /* Plomberie : on serre le raccord, puis l'eau coule */
  .scene .wrench { animation: wrist-turn 0.5s var(--ease-in-out) 0.3s 5; }
  .scene .drop { opacity: 0; animation: drop 0.9s ease-in 2.9s 3; }
  /* Électricité : on branche, la lampe s'allume */
  .scene .screw { animation: wrist-turn 0.45s var(--ease-in-out) 0.3s 5; }
  .scene .glow { animation: glow-on 0.9s ease-out 2.7s both; }
  /* Placo : la plaque est posée, puis vissée */
  .scene .panel { animation: slide-in 700ms var(--ease-out) 0.3s both; }
  .scene .drill { animation: buzz 0.08s linear 1.2s 30; }
  .scene .screw-dot { animation: appear 250ms var(--ease-out) both; }
  .scene .screw-dot:nth-of-type(1) { animation-delay: 1.3s; } .scene .screw-dot:nth-of-type(2) { animation-delay: 1.75s; }
  .scene .screw-dot:nth-of-type(3) { animation-delay: 2.2s; } .scene .screw-dot:nth-of-type(4) { animation-delay: 2.65s; }
  .scene .screw-dot:nth-of-type(5) { animation-delay: 3.1s; }
  /* Toiture : les tuiles sont posées de l'égout vers le faîtage, au rythme du marteau */
  .scene .hammer { animation: swing 0.45s var(--ease-in-out) 0.3s 9; }
  .scene .tile { animation: lay 300ms var(--ease-out) both; }
  .scene .tile:nth-of-type(1) { animation-delay: 0.4s; } .scene .tile:nth-of-type(2) { animation-delay: 0.85s; }
  .scene .tile:nth-of-type(3) { animation-delay: 1.3s; } .scene .tile:nth-of-type(4) { animation-delay: 1.75s; }
  .scene .tile:nth-of-type(5) { animation-delay: 2.2s; } .scene .tile:nth-of-type(6) { animation-delay: 2.65s; }
  .scene .tile:nth-of-type(7) { animation-delay: 3.1s; } .scene .tile:nth-of-type(8) { animation-delay: 3.55s; }
  /* Histoire : le père montre, le fils travaille */
  .scene .point { animation: wrist-turn 1.2s var(--ease-in-out) 0.5s 3; }
  .scene-histoire .trowel { animation-delay: 0.8s; }
  /* Contact : le devis est rempli puis coché */
  .scene .write { animation: buzz 0.22s linear 0.4s 10; }
  .scene .check { animation: appear 300ms var(--ease-out) 2.8s both; }

  @media (prefers-reduced-motion: reduce) {
    .scene *, .scene { animation: none !important; }
    .scene .drop, .scene-fondations .dirt { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .coupe--hero .layer, .coupe--hero .layer-toiture .frame, .coupe--hero .layer-toiture .tiles,
    .coupe--hero .plumb-line, .coupe--hero .plumb-bob, .coupe--hero .lbl {
      animation: fade 300ms ease both;
    }
  }
</style>

<script>
  // Les scènes de l'ouvrier démarrent quand elles entrent à l'écran (utile sur mobile,
  // où la coupe est sous le titre). Sans JavaScript, elles jouent dès le chargement.
  const scenes = document.querySelectorAll<HTMLElement>('.coupe--scene');
  if ('IntersectionObserver' in window && scenes.length) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.removeAttribute('data-wait'); io.unobserve(e.target); }
      }
    }, { threshold: 0.4 });
    for (const el of scenes) {
      const r = el.getBoundingClientRect();
      if (r.top > window.innerHeight * 0.6) { el.setAttribute('data-wait', ''); io.observe(el); }
    }
  }
</script>
