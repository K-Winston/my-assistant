---
import { company, contact, site, area, services } from '../data/site';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  localBusiness?: boolean;
  breadcrumb?: { name: string; path: string }[];
}
const { title, description, noindex = false, localBusiness = false, breadcrumb } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;
// Le nom de l'entreprise est ajouté au titre s'il reste sous 70 caractères (recommandation Google).
const withBrand = `${title} | ${company.name}`;
const fullTitle = title.includes(company.name) || withBrand.length > 70 ? title : withBrand;

const clean = (v: string) => (v.includes('[À COMPLÉTER') ? undefined : v);
const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': new URL('/#entreprise', Astro.site).href,
  name: company.name,
  description: site.defaultDescription,
  url: new URL('/', Astro.site).href,
  image: ogImage,
  telephone: clean(contact.phoneDisplay) ? contact.phoneLink : undefined,
  email: clean(contact.email),
  founder: clean(company.owner) ? { '@type': 'Person', name: company.owner } : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: clean(contact.address.street),
    postalCode: clean(contact.address.postalCode),
    addressLocality: clean(contact.address.city),
    addressRegion: 'Provence-Alpes-Côte d’Azur',
    addressCountry: 'FR',
  },
  areaServed: area.towns.map((t) => ({ '@type': 'City', name: t })),
  openingHours: contact.hoursSchema.length ? contact.hoursSchema : undefined,
  sameAs: contact.googleReviewsUrl ? [contact.googleReviewsUrl] : undefined,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, url: new URL(`/prestations/${s.slug}/`, Astro.site).href },
    })),
  },
};
const crumbs = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.path, Astro.site).href,
  })),
};
const json = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={company.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
{localBusiness && <script type="application/ld+json" set:html={json(business)} />}
{crumbs && <script type="application/ld+json" set:html={json(crumbs)} />}
