---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
---
<header class="site-header on-dark">
  <div class="container header-inner">
    <a class="logo" href="/">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect x="2" y="20" width="28" height="9" />
        <rect x="6" y="11" width="20" height="8" />
        <path d="M4 10 16 2l12 8" fill="none" />
      </svg>
      <span>{site.logoText}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" data-ready="false">
      <span class="nav-toggle-open"><Icon name="menu" class="nav-icon" /></span>
      <span class="nav-toggle-close"><Icon name="close" class="nav-icon" /></span>
      <span class="nav-toggle-label">Menu</span>
    </button>

    <nav class="nav" id="menu-principal" aria-label="Navigation principale">
      <ul class="nav-list">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn-primary nav-cta" href="/#contact">Demander un devis</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--c-line-dark);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: var(--header-h);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: var(--tap);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.1;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-on-dark);
  }
  .logo-mark {
    width: 2rem;
    height: 2rem;
    flex: none;
    fill: var(--c-accent);
    stroke: var(--c-accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0 var(--sp-3);
    background: transparent;
    color: var(--c-on-dark);
    border: 1px solid var(--c-line-dark);
    border-radius: var(--r-sm);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .nav-toggle[data-ready='false'] { visibility: hidden; }
  .nav-toggle :global(.nav-icon) { width: 1.5rem; height: 1.5rem; }
  .nav-toggle-close { display: none; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-open { display: none; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-close { display: inline; }

  .nav-list { list-style: none; margin: 0; padding: 0; }
  .nav-list a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
    font-weight: 500;
    color: var(--c-on-dark);
  }
  .nav-list a:hover { color: var(--c-accent); }

  /* Mobile : menu déroulant (seulement si le JavaScript est actif) */
  @media (max-width: 63.99rem) {
    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      padding: var(--sp-4) var(--gutter) var(--sp-6);
      background: var(--c-dark);
      border-bottom: 1px solid var(--c-line-dark);
    }
    .nav.is-open {
      display: block;
      transition:
        opacity var(--dur-ui) var(--ease-out),
        transform var(--dur-ui) var(--ease-out);
    }
    @starting-style {
      .nav.is-open { opacity: 0; transform: translateY(-8px); }
    }
    @media (prefers-reduced-motion: reduce) {
      @starting-style {
        .nav.is-open { transform: none; }
      }
    }
    .nav-list li { margin: 0; border-bottom: 1px solid var(--c-line-dark); }
    .nav-list a { min-height: 3.25rem; font-size: 1.125rem; }
    .nav-cta { margin-top: var(--sp-5); width: 100%; }
  }

  /* Bureau : navigation en ligne */
  @media (min-width: 64rem) {
    .nav-toggle { display: none; }
    .nav { display: flex; align-items: center; gap: var(--sp-6); }
    .nav-list { display: flex; gap: var(--sp-5); }
    .nav-list li { margin: 0; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('menu-principal');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };
    toggle.dataset.ready = 'true';
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
