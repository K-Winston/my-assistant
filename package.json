    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "html-validate": "^11.22.1",
    "lighthouse": "^13.6.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
